# Copy this file to .env.local and fill in your Supabase project values.
# Find them in Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# OPTIONAL — admin panel (fail-closed: no admin route without these)
# VITE_ADMIN_PATH=/some-secret-path     # secret admin URL (used in robots.txt too)
# VITE_ADMIN_EMAIL=you@example.com      # only this account can sign in
